<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>{{ title_tag | safe }}</title>
<meta name="description" content="{{ meta_desc | safe }}">
<link rel="icon" type="image/png" href="/media/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Jost:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/main.css?v={{ build.time }}">
</head>
<body class="has-action-bar">

{% set nav_solid = true %}{% include "nav.njk" %}

<main style="padding-top:70px">
  <!-- ══ hero ══ -->
  <section class="detail-hero" style="background-image:url('/media/projects/yarzeh/facade-hero.jpg')">
    <div class="detail-hero-inner">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/projects/">Projects</a> / The Yarzeh Mansions</nav>
      <h1>The Yarzeh Mansions</h1>
      
    </div>
  </section>

  <nav class="quick-nav" aria-label="Page sections">
    <div class="quick-nav-inner">
      <a href="#facts">Key facts</a>
      <a href="#gallery">Gallery</a>
      <a href="#amenities">Amenities</a>
      <a href="#specs">Specs</a>
      <a href="#payment">Payment</a>
      <a href="#location">Location</a>
      <a href="/projects/yarzeh-mansions/floor-plans/">Floor plans</a>
      <a class="qn-brochure" href="/media/projects/yarzeh/The-Yarzeh-Mansions-Brochure.pdf" download>Brochure ↓</a>
    </div>
  </nav>

  <div class="with-rail" style="padding-top:0">
    <div>
      <!-- ══ key facts ══ -->
      <section class="detail-section" id="facts" style="margin-top:44px">
        <div class="facts-strip reveal">
          {% for f in facts %}<div class="fact-cell">
          <span class="fk">{{ f.k | safe }}</span>
          <span class="fv">{{ f.v | safe }}</span>
        </div>
        {% endfor %}
        </div>
        <div class="detail-actions reveal">
          <a class="btn btn-navy" href="/media/projects/yarzeh/The-Yarzeh-Mansions-Brochure.pdf" download>Download brochure</a>
          <a class="btn btn-line-navy" href="/projects/yarzeh-mansions/floor-plans/">Residences &amp; floor plans</a>
        </div>
      </section>

      <!-- ══ overview ══ -->
      <section class="detail-section">
        <h2 class="reveal">{{ intro_title | safe }}</h2>
        <div class="detail-prose reveal">
{% for p in intro %}          <p>{{ p | safe }}</p>
{% endfor %}        </div>
      </section>

      <!-- ══ gallery ══ -->
      <section class="detail-section" id="gallery">
        <p class="detail-eyebrow reveal">Gallery</p>
        <h2 class="reveal">A first look</h2>
        <div class="gal-sub reveal">
          <p class="gal-label">Outside renders</p>
        </div>
        <div class="slider reveal" id="gallerySlider">
{% for s in slides %}          <div class="sl-item{% if loop.first %} on{% endif %}" data-cap="{{ s.cap | safe }}" data-full="{{ s.image | safe }}"><img src="{{ s.image | safe }}" alt="{{ s.alt | safe }}"{% if not loop.first %} loading="lazy"{% endif %}></div>
{% endfor %}          <button class="sl-arrow sl-prev" aria-label="Previous image">‹</button>
          <button class="sl-arrow sl-next" aria-label="Next image">›</button>
          <span class="sl-caption"></span>
          <div class="sl-dots" role="tablist"></div>
        </div>
      
        <div class="gal-sub reveal">
          <p class="gal-label">Inside renders · Residence Daisy II</p>
        </div>
        <nav class="interior-nav room-tabs reveal" id="roomTabs" aria-label="Rooms">
          <button type="button" class="on" data-room="bedrooms">Bedrooms</button>
          <button type="button" data-room="bathrooms">Bathrooms</button>
          <button type="button" data-room="salons">Salons & living</button>
          <button type="button" data-room="kitchens">Kitchens & dining</button>
          <button type="button" data-room="lobbies">Lobbies & arrival</button>
          <button type="button" data-room="closets">Walk-in closets</button>
        </nav>
        <div class="room-group on" id="room-bedrooms">
          <div class="strip-wrap">
            <button class="st-btn st-prev" aria-label="Scroll back">‹</button>
            <div class="int-strip">
              <a class="int-thumb" data-group="rm-bedrooms" data-cap="Bedroom I" href="/media/projects/yarzeh/interiors/d2gf-bed1-a.jpg"><img src="/media/projects/yarzeh/interiors/d2gf-bed1-a.jpg" alt="Daisy II, bedroom i" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-bedrooms" data-cap="Bedroom I" href="/media/projects/yarzeh/interiors/d2gf-bed1-b.jpg"><img src="/media/projects/yarzeh/interiors/d2gf-bed1-b.jpg" alt="Daisy II, bedroom i" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-bedrooms" data-cap="Bedroom II" href="/media/projects/yarzeh/interiors/d2gf-bed2-a.jpg"><img src="/media/projects/yarzeh/interiors/d2gf-bed2-a.jpg" alt="Daisy II, bedroom ii" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-bedrooms" data-cap="Bedroom II" href="/media/projects/yarzeh/interiors/d2gf-bed2-b.jpg"><img src="/media/projects/yarzeh/interiors/d2gf-bed2-b.jpg" alt="Daisy II, bedroom ii" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-bedrooms" data-cap="Bedroom II" href="/media/projects/yarzeh/interiors/d2gf-bed2-c.jpg"><img src="/media/projects/yarzeh/interiors/d2gf-bed2-c.jpg" alt="Daisy II, bedroom ii" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-bedrooms" data-cap="Bedroom III" href="/media/projects/yarzeh/interiors/d2gf-bed3-a.jpg"><img src="/media/projects/yarzeh/interiors/d2gf-bed3-a.jpg" alt="Daisy II, bedroom iii" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-bedrooms" data-cap="Bedroom III" href="/media/projects/yarzeh/interiors/d2gf-bed3-b.jpg"><img src="/media/projects/yarzeh/interiors/d2gf-bed3-b.jpg" alt="Daisy II, bedroom iii" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-bedrooms" data-cap="Sleeping area" href="/media/projects/yarzeh/interiors/d2rf-sleep-a.jpg"><img src="/media/projects/yarzeh/interiors/d2rf-sleep-a.jpg" alt="Daisy II, sleeping area" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-bedrooms" data-cap="Sleeping area" href="/media/projects/yarzeh/interiors/d2rf-sleep-b.jpg"><img src="/media/projects/yarzeh/interiors/d2rf-sleep-b.jpg" alt="Daisy II, sleeping area" loading="lazy"></a>
            </div>
            <button class="st-btn st-next" aria-label="Scroll forward">›</button>
          </div>
        </div>
        <div class="room-group" id="room-bathrooms">
          <div class="strip-wrap">
            <button class="st-btn st-prev" aria-label="Scroll back">‹</button>
            <div class="int-strip">
              <a class="int-thumb" data-group="rm-bathrooms" data-cap="Bathroom" href="/media/projects/yarzeh/interiors/d2gf-bath-a.jpg"><img src="/media/projects/yarzeh/interiors/d2gf-bath-a.jpg" alt="Daisy II, bathroom" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-bathrooms" data-cap="Bathroom" href="/media/projects/yarzeh/interiors/d2gf-bath-b.jpg"><img src="/media/projects/yarzeh/interiors/d2gf-bath-b.jpg" alt="Daisy II, bathroom" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-bathrooms" data-cap="Bathroom" href="/media/projects/yarzeh/interiors/d2gf-bath-c.jpg"><img src="/media/projects/yarzeh/interiors/d2gf-bath-c.jpg" alt="Daisy II, bathroom" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-bathrooms" data-cap="Bathroom" href="/media/projects/yarzeh/interiors/d2gf-bath-d.jpg"><img src="/media/projects/yarzeh/interiors/d2gf-bath-d.jpg" alt="Daisy II, bathroom" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-bathrooms" data-cap="Bathroom" href="/media/projects/yarzeh/interiors/d2gf-bath-e.jpg"><img src="/media/projects/yarzeh/interiors/d2gf-bath-e.jpg" alt="Daisy II, bathroom" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-bathrooms" data-cap="Bathroom" href="/media/projects/yarzeh/interiors/d2gf-bath-f.jpg"><img src="/media/projects/yarzeh/interiors/d2gf-bath-f.jpg" alt="Daisy II, bathroom" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-bathrooms" data-cap="Bathroom" href="/media/projects/yarzeh/interiors/d2gf-bath-g.jpg"><img src="/media/projects/yarzeh/interiors/d2gf-bath-g.jpg" alt="Daisy II, bathroom" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-bathrooms" data-cap="Bathroom" href="/media/projects/yarzeh/interiors/d2gf-bath-h.jpg"><img src="/media/projects/yarzeh/interiors/d2gf-bath-h.jpg" alt="Daisy II, bathroom" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-bathrooms" data-cap="Guest WC" href="/media/projects/yarzeh/interiors/d2ff-wc.jpg"><img src="/media/projects/yarzeh/interiors/d2ff-wc.jpg" alt="Daisy II, guest wc" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-bathrooms" data-cap="Bathroom" href="/media/projects/yarzeh/interiors/d2rf-bath-a.jpg"><img src="/media/projects/yarzeh/interiors/d2rf-bath-a.jpg" alt="Daisy II, bathroom" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-bathrooms" data-cap="Bathroom" href="/media/projects/yarzeh/interiors/d2rf-bath-b.jpg"><img src="/media/projects/yarzeh/interiors/d2rf-bath-b.jpg" alt="Daisy II, bathroom" loading="lazy"></a>
            </div>
            <button class="st-btn st-next" aria-label="Scroll forward">›</button>
          </div>
        </div>
        <div class="room-group" id="room-salons">
          <div class="strip-wrap">
            <button class="st-btn st-prev" aria-label="Scroll back">‹</button>
            <div class="int-strip">
              <a class="int-thumb" data-group="rm-salons" data-cap="TV room" href="/media/projects/yarzeh/interiors/d2gf-tv-a.jpg"><img src="/media/projects/yarzeh/interiors/d2gf-tv-a.jpg" alt="Daisy II, tv room" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-salons" data-cap="TV room" href="/media/projects/yarzeh/interiors/d2gf-tv-b.jpg"><img src="/media/projects/yarzeh/interiors/d2gf-tv-b.jpg" alt="Daisy II, tv room" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-salons" data-cap="Grand salons & dining" href="/media/projects/yarzeh/interiors/d2ff-salon-a.jpg"><img src="/media/projects/yarzeh/interiors/d2ff-salon-a.jpg" alt="Daisy II, grand salons & dining" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-salons" data-cap="Grand salons & dining" href="/media/projects/yarzeh/interiors/d2ff-salon-b.jpg"><img src="/media/projects/yarzeh/interiors/d2ff-salon-b.jpg" alt="Daisy II, grand salons & dining" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-salons" data-cap="Grand salons & dining" href="/media/projects/yarzeh/interiors/d2ff-salon-c.jpg"><img src="/media/projects/yarzeh/interiors/d2ff-salon-c.jpg" alt="Daisy II, grand salons & dining" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-salons" data-cap="Living & lounge" href="/media/projects/yarzeh/interiors/d2rf-living-a.jpg"><img src="/media/projects/yarzeh/interiors/d2rf-living-a.jpg" alt="Daisy II, living & lounge" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-salons" data-cap="Living & lounge" href="/media/projects/yarzeh/interiors/d2rf-living-b.jpg"><img src="/media/projects/yarzeh/interiors/d2rf-living-b.jpg" alt="Daisy II, living & lounge" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-salons" data-cap="Living & lounge" href="/media/projects/yarzeh/interiors/d2rf-living-c.jpg"><img src="/media/projects/yarzeh/interiors/d2rf-living-c.jpg" alt="Daisy II, living & lounge" loading="lazy"></a>
            </div>
            <button class="st-btn st-next" aria-label="Scroll forward">›</button>
          </div>
        </div>
        <div class="room-group" id="room-kitchens">
          <div class="strip-wrap">
            <button class="st-btn st-prev" aria-label="Scroll back">‹</button>
            <div class="int-strip">
              <a class="int-thumb" data-group="rm-kitchens" data-cap="Kitchenette" href="/media/projects/yarzeh/interiors/d2gf-kitchenette.jpg"><img src="/media/projects/yarzeh/interiors/d2gf-kitchenette.jpg" alt="Daisy II, kitchenette" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-kitchens" data-cap="Kitchen" href="/media/projects/yarzeh/interiors/d2ff-kitchen.jpg"><img src="/media/projects/yarzeh/interiors/d2ff-kitchen.jpg" alt="Daisy II, kitchen" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-kitchens" data-cap="Kitchenette & dining" href="/media/projects/yarzeh/interiors/d2rf-kitch-a.jpg"><img src="/media/projects/yarzeh/interiors/d2rf-kitch-a.jpg" alt="Daisy II, kitchenette & dining" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-kitchens" data-cap="Kitchenette & dining" href="/media/projects/yarzeh/interiors/d2rf-kitch-b.jpg"><img src="/media/projects/yarzeh/interiors/d2rf-kitch-b.jpg" alt="Daisy II, kitchenette & dining" loading="lazy"></a>
            </div>
            <button class="st-btn st-next" aria-label="Scroll forward">›</button>
          </div>
        </div>
        <div class="room-group" id="room-lobbies">
          <div class="strip-wrap">
            <button class="st-btn st-prev" aria-label="Scroll back">‹</button>
            <div class="int-strip">
              <a class="int-thumb" data-group="rm-lobbies" data-cap="Private lobby" href="/media/projects/yarzeh/interiors/d2gf-lobby-a.jpg"><img src="/media/projects/yarzeh/interiors/d2gf-lobby-a.jpg" alt="Daisy II, private lobby" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-lobbies" data-cap="Private lobby" href="/media/projects/yarzeh/interiors/d2gf-lobby-b.jpg"><img src="/media/projects/yarzeh/interiors/d2gf-lobby-b.jpg" alt="Daisy II, private lobby" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-lobbies" data-cap="Private lobby" href="/media/projects/yarzeh/interiors/d2gf-lobby-c.jpg"><img src="/media/projects/yarzeh/interiors/d2gf-lobby-c.jpg" alt="Daisy II, private lobby" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-lobbies" data-cap="Entrance lobby" href="/media/projects/yarzeh/interiors/d2ff-lobby-a.jpg"><img src="/media/projects/yarzeh/interiors/d2ff-lobby-a.jpg" alt="Daisy II, entrance lobby" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-lobbies" data-cap="Entrance lobby" href="/media/projects/yarzeh/interiors/d2ff-lobby-b.jpg"><img src="/media/projects/yarzeh/interiors/d2ff-lobby-b.jpg" alt="Daisy II, entrance lobby" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-lobbies" data-cap="Entrance lobby" href="/media/projects/yarzeh/interiors/d2ff-lobby-c.jpg"><img src="/media/projects/yarzeh/interiors/d2ff-lobby-c.jpg" alt="Daisy II, entrance lobby" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-lobbies" data-cap="Entrance lobby" href="/media/projects/yarzeh/interiors/d2ff-lobby-d.jpg"><img src="/media/projects/yarzeh/interiors/d2ff-lobby-d.jpg" alt="Daisy II, entrance lobby" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-lobbies" data-cap="Entrance lobby" href="/media/projects/yarzeh/interiors/d2ff-lobby-e.jpg"><img src="/media/projects/yarzeh/interiors/d2ff-lobby-e.jpg" alt="Daisy II, entrance lobby" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-lobbies" data-cap="Entrance lobby" href="/media/projects/yarzeh/interiors/d2ff-lobby-f.jpg"><img src="/media/projects/yarzeh/interiors/d2ff-lobby-f.jpg" alt="Daisy II, entrance lobby" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-lobbies" data-cap="Private lift landing" href="/media/projects/yarzeh/interiors/d2rf-lift-a.jpg"><img src="/media/projects/yarzeh/interiors/d2rf-lift-a.jpg" alt="Daisy II, private lift landing" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-lobbies" data-cap="Private lift landing" href="/media/projects/yarzeh/interiors/d2rf-lift-b.jpg"><img src="/media/projects/yarzeh/interiors/d2rf-lift-b.jpg" alt="Daisy II, private lift landing" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-lobbies" data-cap="Private lift landing" href="/media/projects/yarzeh/interiors/d2rf-lift-c.jpg"><img src="/media/projects/yarzeh/interiors/d2rf-lift-c.jpg" alt="Daisy II, private lift landing" loading="lazy"></a>
            </div>
            <button class="st-btn st-next" aria-label="Scroll forward">›</button>
          </div>
        </div>
        <div class="room-group" id="room-closets">
          <div class="strip-wrap">
            <button class="st-btn st-prev" aria-label="Scroll back">‹</button>
            <div class="int-strip">
              <a class="int-thumb" data-group="rm-closets" data-cap="Master walk-in closet" href="/media/projects/yarzeh/interiors/d2gf-wic-a.jpg"><img src="/media/projects/yarzeh/interiors/d2gf-wic-a.jpg" alt="Daisy II, master walk-in closet" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-closets" data-cap="Master walk-in closet" href="/media/projects/yarzeh/interiors/d2gf-wic-b.jpg"><img src="/media/projects/yarzeh/interiors/d2gf-wic-b.jpg" alt="Daisy II, master walk-in closet" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-closets" data-cap="Walk-in closet" href="/media/projects/yarzeh/interiors/d2rf-wic-a.jpg"><img src="/media/projects/yarzeh/interiors/d2rf-wic-a.jpg" alt="Daisy II, walk-in closet" loading="lazy"></a>
              <a class="int-thumb" data-group="rm-closets" data-cap="Walk-in closet" href="/media/projects/yarzeh/interiors/d2rf-wic-b.jpg"><img src="/media/projects/yarzeh/interiors/d2rf-wic-b.jpg" alt="Daisy II, walk-in closet" loading="lazy"></a>
            </div>
            <button class="st-btn st-next" aria-label="Scroll forward">›</button>
          </div>
        </div>

        <div class="gal-sub reveal">
          <p class="gal-label">360° walkthrough · Residence Daisy II</p>
        </div>
        <div class="interior-nav walk-tabs reveal" id="walkTabs">
          <button type="button" class="on" data-src="https://www.coohom.com/pub/tool/panorama/show?obsPlanId=3FO3H6GF15MJ&locale=en_US">Lower floor</button>
          <button type="button" data-src="https://www.coohom.com/pub/tool/panorama/show?obsPlanId=3FO3H6PIP68E&locale=en_US">Main floor</button>
          <button type="button" data-src="https://www.coohom.com/pub/tool/panorama/show?obsPlanId=3FO3H97BAP1F&locale=en_US">Roof floor</button>
        </div>
        <div class="walk-embed reveal">
          <iframe id="walkFrame" src="https://www.coohom.com/pub/tool/panorama/show?obsPlanId=3FO3H6GF15MJ&locale=en_US" title="360° walkthrough of Daisy II" loading="lazy" allowfullscreen></iframe>
        </div>
        <p class="walk-fallback reveal"><a id="walkExt" href="https://www.coohom.com/pub/tool/panorama/show?obsPlanId=3FO3H6GF15MJ&locale=en_US" target="_blank" rel="noopener">Open the walkthrough full screen ↗</a></p>
      </section>

      <!-- ══ amenities ══ -->
      <section class="detail-section" id="amenities">
        <p class="detail-eyebrow reveal">Life at the Mansions</p>
        <h2 class="reveal">Amenities</h2>
        <ul class="amen-list reveal">
{% for a in amenities %}          <li>{{ a.icon | safe }}{{ a.label | safe }}</li>
{% endfor %}        </ul>
      </section>



      <!-- ══ craftsmanship ══ -->
      <section class="detail-section" id="specs">
        <p class="detail-eyebrow reveal">Craftsmanship</p>
        <h2 class="reveal">Built without shortcuts</h2>
        <div class="spec-list reveal">
          {% for s in specs %}<div class="spec-row"><h4>{{ s.title | safe }}</h4><p>{{ s.text | safe }}</p></div>
          {% endfor %}</div>
      </section>

      <!-- ══ payment ══ -->
      <section class="detail-section" id="payment">
        <p class="detail-eyebrow reveal">Payment terms</p>
        <h2 class="reveal">Four steps to your title deed</h2>
        <div class="timeline reveal">
          <div class="tl-line"></div>
          <div class="tl-steps">
            {% for t in timeline %}<div class="tl-step"><span class="pct">{{ t.pct }}</span><span class="tl-dot"></span><p>{{ t.text | safe }}</p></div>
            {% endfor %}</div>
        </div>
      </section>
    
      <!-- ══ location ══ -->
      {% set loc_name = "The Yarzeh Mansions" %}{% set loc_q = "33%C2%B050%2718.3%22N+35%C2%B033%2704.6%22E" %}{% set loc_z = "17" %}{% set loc_illu %}
        <a class="loc-illustration reveal" href="/media/projects/yarzeh/location-map.jpg" data-lightbox>
          <img src="/media/projects/yarzeh/location-map.jpg" alt="Illustrated map of Yarzeh showing the Mansions, the road to Beirut, the Yarzeh Country Club and Alyarz Leisure Club" loading="lazy">
        </a>
{% endset %}{% include "location.njk" %}

    </div>

    <!-- ══ persistent contact rail ══ -->
    {% include "rail.njk" %}
  </div>
</main>

<!-- mobile action bar -->
{% include "action-bar.njk" %}

<!-- lightbox -->
<button class="to-top" id="toTop" aria-label="Back to top">↑</button>

<div class="lightbox" id="lightbox" aria-modal="true" role="dialog">
  <button class="lb-close" aria-label="Close">Close ✕</button>
  <button class="lb-nav lb-prev" aria-label="Previous">‹</button>
  <img src="" alt="Enlarged view">
  <button class="lb-nav lb-next" aria-label="Next">›</button>
  <span class="lb-count"></span>
  <span class="lb-cap"></span>
  <a class="lb-dl" href="" download>Download</a>
</div>

{% include "footer.njk" %}

<script src="/js/projects.js?v={{ build.time }}"></script>
</body>
</html>
