<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>{{ title_tag | safe }}</title>
<meta name="description" content="{{ meta_desc | safe }}">
<link rel="icon" type="image/png" href="/media/favicon.png">
<link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Jost:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/main.css?v={{ build.time }}">
{% include "pixels-head.njk" %}
</head>
<body class="has-action-bar">

{% set nav_solid = true %}{% include "nav.njk" %}

<main style="padding-top:70px">
  <section class="detail-hero" style="background-image:url('/media/projects/jamhour/facade.jpg')">
    <div class="detail-hero-inner">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/projects/">Projects</a> / Pride of Jamhour</nav>
      <h1>Pride of Jamhour</h1>
    </div>
  </section>

  <div class="with-rail" style="padding-top:0">
    <div>
      <section class="detail-section" id="facts" style="margin-top:44px">
        <div class="facts-strip reveal">
          {% for f in facts %}<div class="fact-cell">
          <span class="fk">{{ f.k | safe }}</span>
          <span class="fv">{{ f.v | safe }}</span>
        </div>
        {% endfor %}
        </div>
      </section>

      <section class="detail-section">
        <h2 class="reveal">{{ intro_title | safe }}</h2>
        <div class="detail-prose reveal">
{% for p in intro %}          <p>{{ p | safe }}</p>
{% endfor %}        </div>
      </section>

      <section class="detail-section" id="film">
        <p class="detail-eyebrow reveal">{{ site.ui.film_eyebrow | safe }}</p>
        <h2 class="reveal">{{ site.ui.film_title | safe }}</h2>
        <div class="walk-embed reveal">
          <iframe src="{{ film_url }}" title="Pride of Jamhour — project film" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
      </section>

      <section class="detail-section" id="gallery">
        <p class="detail-eyebrow reveal">{{ site.ui.gallery_eyebrow | safe }}</p>
        <h2 class="reveal">{{ gallery_title | safe }}</h2>
        <div class="slider reveal" id="gallerySlider">
{% for s in slides %}          <div class="sl-item{% if loop.first %} on{% endif %}" data-cap="{{ s.cap | safe }}" data-full="{{ s.image | safe }}"><img src="{{ s.image | safe }}" alt="{{ s.alt | safe }}"{% if not loop.first %} loading="lazy"{% endif %}></div>
{% endfor %}          <button class="sl-arrow sl-prev" aria-label="Previous image">‹</button>
          <button class="sl-arrow sl-next" aria-label="Next image">›</button>
          <span class="sl-caption"></span>
          <div class="sl-dots" role="tablist"></div>
        </div>
      </section>

      <section class="detail-section" id="amenities">
        <p class="detail-eyebrow reveal">{{ amen_eyebrow | safe }}</p>
        <h2 class="reveal">{{ site.ui.amenities | safe }}</h2>
        <ul class="amen-list reveal">
{% for a in amenities %}          <li>{{ a.icon | safe }}{{ a.label | safe }}</li>
{% endfor %}        </ul>
      </section>
      <!-- ══ location ══ -->
      {% set loc_name = "Pride of Jamhour" %}{% set loc_q = "Pride+of+Jamhour,+Jamhour" %}{% set loc_z = "16" %}{% set loc_illu = false %}{% include "location.njk" %}


    </div>

    {% include "rail.njk" %}
  </div>
</main>

<!-- mobile action bar -->
{% include "action-bar.njk" %}

<!-- lightbox -->
<button class="to-top" id="toTop" aria-label="Back to top">↑</button>

<div class="lightbox" id="lightbox" aria-modal="true" role="dialog">
  <button class="lb-close" aria-label="Close">Close ✕</button>
  <button class="lb-nav lb-prev" aria-label="Previous">‹</button>
  <img src="" alt="Enlarged view">
  <button class="lb-nav lb-next" aria-label="Next">›</button>
  <span class="lb-count"></span>
  <span class="lb-cap"></span>
  <a class="lb-dl" href="" download>Download</a>
</div>

{% include "footer.njk" %}

<script src="/js/projects.js?v={{ build.time }}"></script>
{% include "pixels-body.njk" %}
</body>
</html>
