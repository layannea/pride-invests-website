<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>{{ title_tag | safe }}</title>
<meta name="description" content="{{ meta_desc | safe }}">
<link rel="icon" type="image/png" href="/media/favicon.png">
<link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Jost:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/main.css?v={{ build.time }}">
{% include "pixels-head.njk" %}
</head>
<body>

{% set nav_solid = true %}{% include "nav.njk" %}

<main class="page">
  <div class="page-head" style="text-align:center;max-width:1000px;margin:0 auto">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / Contact</nav>
    <h1 class="page-title">{{ page_title | safe }}</h1>
    <p class="page-intro" style="margin-left:auto;margin-right:auto">{{ page_intro | safe }}</p>
  </div>

  <div class="contact-grid">
    <div class="contact-rail contact-card">{% include "rail-inner.njk" %}</div>

    <div>
      <section class="destinations offices-compact" style="padding:0;background:none;text-align:left">
        <div class="office-card">
        <h2 class="section-title office-title">{{ offices_title | safe }}</h2>
        <div class="dest-row" style="grid-template-columns:1fr;gap:26px;max-width:none">
          {% for o in site.offices %}<div class="dest" style="align-items:flex-start;text-align:left">
            <span class="dest-city" style="font-size:1.12rem">{{ o.city }} · {{ o.country }}</span>
            <address class="dest-details" style="align-items:flex-start">{{ o.address | safe }}
              <a class="dest-tel" href="tel:{{ site.phone_tel }}" aria-label="Call our Lebanon home office on {{ site.phone_display }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg><span>{{ site.phone_display }}</span></a>
              <a class="dest-wa" href="https://wa.me/{{ site.wa_number }}" target="_blank" rel="noopener" aria-label="Message us on WhatsApp at {{ site.wa_display }} (opens WhatsApp in a new tab)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.174-.297-.019-.458.13-.606.134-.133.347-.347.52-.52.174-.174.232-.298.347-.497.115-.198.058-.371-.015-.52-.074-.149-.669-1.612-.916-2.207-.244-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg><span>{{ site.wa_display }}</span></a>
              <a class="dest-mail" href="mailto:{{ site.email }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg><span>{{ site.email }}</span></a></address>
          </div>{% endfor %}
        </div>
        </div>
      </section>
    </div>
  </div>
</main>

{% include "footer.njk" %}

<script src="/js/projects.js?v={{ build.time }}"></script>
{% include "pixels-body.njk" %}
</body>
</html>
