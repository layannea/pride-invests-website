{% set ym = (collections.projectPages | findSlug("yarzeh-mansions")).data %}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>{{ ym.plans_page.title_tag | safe }}</title>
<meta name="description" content="{{ ym.plans_page.meta_desc | safe }}">
<link rel="icon" type="image/png" href="/media/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Jost:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/main.css?v={{ build.time }}">
{% include "pixels-head.njk" %}
</head>
<body class="has-action-bar">

{% set nav_solid = true %}{% include "nav.njk" %}

<main class="page plans-page">
  <div class="page-head">
    <a class="fp-back" href="/projects/yarzeh-mansions/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Back to The Yarzeh Mansions</span></a>
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/projects/">Projects</a> / <a href="/projects/yarzeh-mansions/">The Yarzeh Mansions</a> / Floor plans</nav>
    <h1 class="page-title">{{ ym.plans_page.title | safe }}</h1>
    <p class="page-intro">{{ ym.plans_page.intro | safe }}</p>
    <div class="detail-actions" style="margin-top:20px">
      {% if ym.brochure %}<a class="btn btn-navy" href="{{ ym.brochure }}" download>Download brochure</a>{% endif %}
    </div>
  </div>

  <div class="with-rail">
    <div>
      <section class="detail-section" id="residences" style="margin-top:0">
{% for r in ym.plans_page.residences %}{% if loop.first or r.mansion != ym.plans_page.residences[loop.index0 - 1].mansion %}<p class="res-mansion">{{ r.mansion | safe }}</p>
{% endif %}        <article class="res-card reveal" id="{{ r.slug }}">
          <div class="res-head">
            <h3>{{ r.name | safe }}</h3><span class="res-type">{{ r.type | safe }}</span>
            <span class="res-price">{{ r.price | safe }}</span>
          </div>
          <div class="res-specs">
{% for s in r.specs %}            <span>{{ s | safe }}</span>
{% endfor %}          </div>
          <p>{{ r.text | safe }}</p>
          <div class="plans open">
            <p class="plans-label">Floor plans</p>
            <div class="plan-row">
{% for p in r.plans %}              <a class="plan-thumb" data-group="plans-{{ r.slug }}" href="{{ p.file }}">
                <img src="{{ p.file }}" alt="{{ p.alt | safe }}" loading="lazy"><span>{{ p.label | safe }}</span>
              </a>
{% endfor %}            </div>
          </div>
{% if r.link_text %}          <a class="text-link" href="{{ r.link_url }}" style="margin-top:24px;display:inline-block">{{ r.link_text | safe }}</a>
{% endif %}        </article>
{% if not loop.last %}
{% endif %}{% endfor %}      </section>
    </div>

    <!-- ══ persistent contact rail ══ -->
    {% include "rail.njk" %}
  </div>
</main>

<!-- mobile action bar -->
{% include "action-bar.njk" %}

<!-- lightbox -->
<button class="to-top" id="toTop" aria-label="Back to top">↑</button>

<div class="lightbox" id="lightbox" aria-modal="true" role="dialog">
  <button class="lb-close" aria-label="Close">Close ✕</button>
  <button class="lb-nav lb-prev" aria-label="Previous">‹</button>
  <img src="" alt="Enlarged view">
  <button class="lb-nav lb-next" aria-label="Next">›</button>
  <span class="lb-count"></span>
  <span class="lb-cap"></span>
  <a class="lb-dl" href="" download>Download</a>
</div>

{% include "footer.njk" %}

<script src="/js/projects.js?v={{ build.time }}"></script>
{% include "pixels-body.njk" %}
</body>
</html>
