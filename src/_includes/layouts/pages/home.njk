<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>{{ title_tag | safe }}</title>
<meta name="description" content="{{ meta_desc | safe }}">
<link rel="icon" type="image/png" sizes="64x64" href="/media/favicon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/media/favicon-32.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Jost:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<script>(function(){try{if(sessionStorage.getItem('pi_intro')){document.documentElement.classList.add('skip-intro')}else{sessionStorage.setItem('pi_intro','1')}}catch(e){}})()</script>
<link rel="stylesheet" href="/css/main.css?v={{ build.time }}">
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js" defer></script>
<script>
  window.addEventListener("load", function () {
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", function (user) {
        if (!user) window.netlifyIdentity.on("login", function () { document.location.href = "/cms/"; });
      });
    }
  });
</script>
{% include "pixels-head.njk" %}
</head>
<body>

<!-- ══════════ PRELOADER ══════════ -->
<div class="preloader" id="preloader" aria-hidden="true">
  <svg class="preloader-mark" viewBox="0 0 148 229" width="76" height="118">
    <polygon class="wedge navy" points="49,229 0,0 125,0 88,229"/>
    <polygon class="wedge gray" points="99,229 68,89 148,89 132,229"/>
  </svg>
</div>

<!-- ══════════ NAVBAR ══════════ -->
{% set nav_solid = false %}{% include "nav.njk" %}

<!-- ══════════ HERO — the living slideshow ══════════ -->
<section class="hero" id="hero">
  <div class="hero-slides" id="heroSlides">

    <figure class="slide is-active" data-caption="The Yarzeh Mansions · Poolside at dusk">
      <video class="slide-video" muted playsinline preload="auto" poster="/media/landing/poster-clouds-v3.jpg">
        <source src="/media/landing/scene-clouds-v3.mp4" type="video/mp4">
      </video>
    </figure>

    <figure class="slide" data-caption="The Yarzeh Mansions · Baabda">
      <video class="slide-video" muted playsinline preload="auto" poster="/media/landing/poster-car-v3.jpg">
        <source src="/media/landing/scene-car-v3.mp4" type="video/mp4">
      </video>
    </figure>

    <figure class="slide" data-caption="Louayzeh Village · Wellness &amp; leisure">
      <video class="slide-video" muted playsinline preload="auto" poster="/media/landing/poster-treadmill-v3.jpg">
        <source src="/media/landing/scene-treadmill-v3.mp4" type="video/mp4">
      </video>
    </figure>

    <figure class="slide" data-caption="Louayzeh Village · Nightfall">
      <video class="slide-video" muted playsinline preload="auto" poster="/media/landing/poster-lights-v3.jpg">
        <source src="/media/landing/scene-lights-v3.mp4" type="video/mp4">
      </video>
    </figure>

  </div>
  <div class="hero-scrim"></div>

  <div class="hero-content">
    <svg viewBox="0 0 148 229" class="hero-mark" aria-hidden="true"><polygon class="navy" points="0,0 125,0 88,229 49,229"/><polygon class="gray" points="68,89 148,89 132,229 99,229"/></svg>
    <h1 class="hero-title"><span class="w1">{{ hero_word_1 | safe }}</span><span class="w2">{{ hero_word_2 | safe }}</span></h1>
    <p class="hero-slogan">{{ slogan | safe }}</p>
    <div class="hero-cta">
      <a class="btn btn-ghost" href="/projects/">Explore our projects</a>
      <a class="btn btn-line" href="/contact/">Book a viewing</a>
    </div>
  </div>

  <!-- vertical slide rail -->
  <aside class="hero-rail" id="heroRail" aria-hidden="true"></aside>

  <div class="hero-caption" id="heroCaption">The Yarzeh Mansions · Poolside at dusk</div>
</section>

<!-- ══════════ MANIFESTO ══════════ -->
<section class="manifesto" id="manifesto">
  <p class="eyebrow reveal">Developer · Builder · Partner</p>
  <h2 class="statement reveal">{{ statement | safe }}</h2>
  <div class="fact-row">
    {% for s in stats %}<div class="fact reveal"><span class="fact-k">{{ s.k | safe }}</span><span class="fact-l">{{ s.l | safe }}</span></div>
    {% endfor %}</div>
</section>

<!-- ══════════ FEATURED PROJECTS ══════════ -->
<section class="projects" id="projects">
  <p class="eyebrow eyebrow-strong reveal">{{ featured.eyebrow | safe }}</p>
  <h2 class="section-title reveal">{{ featured.title | safe }}</h2>

{% for c in featured.cards %}  <article class="project{% if not loop.first %} flip{% endif %} reveal">
    <a class="project-media" href="{{ c.url }}" style="background-image:url('{{ c.image }}')">
      <span class="project-status">{{ c.status | safe }}</span>
    </a>
    <div class="project-info">
      <span class="project-loc">{{ c.loc | safe }}</span>
      <h3><a href="{{ c.url }}">{{ c.name | safe }}</a></h3>
      <p>{{ c.text | safe }}</p>
      <a class="text-link" href="{{ c.url }}">{{ c.cta | safe }}</a>
    </div>
  </article>

{% if not loop.last %}  <p class="eyebrow eyebrow-strong reveal" style="margin-top:30px">{{ c.next_kicker | safe }}</p>

{% endif %}{% endfor %}  <p class="eyebrow eyebrow-strong reveal" style="margin-top:30px">{{ horizon_kicker | safe }}</p>
  <div class="horizon-grid">
    {% for h in horizon %}<article class="horizon-card hc-photo" style="background-image:url('{{ h.image }}')">
      <span class="hc-soon">{{ h.badge | safe }}</span>
      <span class="hc-country">{{ h.country | safe }}</span>
      <h3>{{ h.name | safe }}</h3>
    </article>
    {% endfor %}</div>
  </div>
</section>

<!-- ══════════ SALES OFFICES ══════════ -->
<section class="destinations" id="offices">
  <h2 class="section-title reveal">{{ offices_title | safe }}</h2>
  <div class="dest-row">
    {% for o in site.offices %}<div class="dest reveal">
      <span class="dest-city">{{ o.city }}</span>
      <span class="dest-country">{{ o.country }}</span>
      <address class="dest-details">
        <span class="dest-addr">{{ o.address | safe }}</span>
        <a class="dest-tel" href="tel:{{ site.phone_tel }}" aria-label="Call our Lebanon home office on {{ site.phone_display }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg><span>{{ site.phone_display }}</span></a>
        <a class="dest-wa" href="https://wa.me/{{ site.wa_number }}" target="_blank" rel="noopener" aria-label="Message us on WhatsApp at {{ site.wa_display }} (opens WhatsApp in a new tab)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.174-.297-.019-.458.13-.606.134-.133.347-.347.52-.52.174-.174.232-.298.347-.497.115-.198.058-.371-.015-.52-.074-.149-.669-1.612-.916-2.207-.244-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg><span>{{ site.wa_display }}</span></a>
        <a class="dest-mail" href="mailto:{{ site.email }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg><span>{{ site.email }}</span></a>
      </address>
    </div>{% endfor %}
  </div>
</section>

<!-- ══════════ CTA ══════════ -->
<section class="cta-band">
  <div class="cta-inner">
    <p class="eyebrow reveal">{{ site.ui.speak | safe }}</p>
    <h2 class="reveal">Ready to find your address?</h2>
    <p class="reveal">Book a private site visit or request a brochure. Our team replies within one working day.</p>
    <div class="hero-cta reveal">
      <a class="btn btn-white" href="/contact/">Book a site visit</a>
      <a class="btn btn-line btn-icon" href="tel:{{ site.phone_tel }}" aria-label="Call our Lebanon home office on {{ site.phone_display }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg><span>Call {{ site.phone_display }}</span></a>
      <a class="btn btn-line btn-icon btn-wa" href="https://wa.me/{{ site.wa_number }}" target="_blank" rel="noopener" aria-label="Message us on WhatsApp at {{ site.wa_display }} (opens WhatsApp in a new tab)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.174-.297-.019-.458.13-.606.134-.133.347-.347.52-.52.174-.174.232-.298.347-.497.115-.198.058-.371-.015-.52-.074-.149-.669-1.612-.916-2.207-.244-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg><span>WhatsApp {{ site.wa_display }}</span></a>
    </div>
    <div class="cta-social reveal" aria-label="Follow Pride Invests">
      <a class="cta-soc cta-fb" href="{{ site.facebook }}" target="_blank" rel="noopener" aria-label="Pride Invests on Facebook (opens in a new tab)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>
      <a class="cta-soc cta-li" href="{{ site.linkedin }}" target="_blank" rel="noopener" aria-label="Pride Invests on LinkedIn (opens in a new tab)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3V9zm7 0h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.6c0-1.3 0-3-1.9-3s-2.2 1.4-2.2 2.9V21h-4V9z"/></svg></a>
      <a class="cta-soc cta-ig" href="{{ site.instagram }}" target="_blank" rel="noopener" aria-label="Pride Invests on Instagram (opens in a new tab)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4.3c2.5 0 2.8 0 3.8.1 2.6.1 3.8 1.3 3.9 3.9 0 1 0 1.3 0 3.7s0 2.8 0 3.7c-.1 2.6-1.3 3.8-3.9 3.9-1 .1-1.3.1-3.8.1s-2.8 0-3.8-.1c-2.6-.1-3.8-1.3-3.9-3.9 0-1 0-1.3 0-3.7s0-2.8 0-3.7C4.4 5.7 5.6 4.5 8.2 4.4c1-.1 1.3-.1 3.8-.1zM12 2.2c-2.6 0-2.9 0-3.9.1-3.4.2-5.3 2-5.5 5.5-.1 1-.1 1.3-.1 3.9s0 3 .1 4c.2 3.4 2 5.3 5.5 5.5 1 0 1.3.1 3.9.1s3 0 4-.1c3.4-.2 5.3-2 5.5-5.5 0-1 .1-1.3.1-3.9s0-3-.1-4c-.2-3.4-2-5.3-5.5-5.5-1-.1-1.4-.1-4-.1zm0 4.9a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.2a3.2 3.2 0 1 1 0-6.5 3.2 3.2 0 0 1 0 6.5zm5.2-9.6a1.2 1.2 0 1 0 0 2.3 1.2 1.2 0 0 0 0-2.3z"/></svg></a>
    </div>
  </div>
</section>

<!-- ══════════ FOOTER ══════════ -->
{% include "footer.njk" %}

<script src="/js/main.js?v={{ build.time }}"></script>
{% include "pixels-body.njk" %}
</body>
</html>
