        <article class="pcard reveal">
          <a class="pcard-cover" href="/projects/louayzeh-village/" aria-label="View Louayzeh Village"></a>
          <a class="pcard-media" href="/projects/louayzeh-village/">
            <img src="/media/projects/louayzeh/village-day.jpg" alt="Louayzeh Village illuminated at night on its wooded hillside" loading="lazy">
            <span class="pcard-badge">Upcoming</span>
